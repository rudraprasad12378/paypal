# Mandate - Safe AI Shopping Agent Wallet Configuration
# Copy this file to .env.local to customize your environment.

# ==========================================
# Google Gemini API (Free Tier)
# Get a free key at: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# PayPal Developer Sandbox (Orders API v2)
# Get Sandbox keys at: https://developer.paypal.com/dashboard/applications/sandbox
# If left blank, Mandate runs in authentic Simulated Sandbox mode.
# ==========================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

