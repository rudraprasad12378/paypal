{
  "name": "paypal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-css.js && next dev",
    "build": "node scripts/build-css.js && next build",
    "build:css": "node scripts/build-css.js",
    "build:css:watch": "node scripts/build-css.js --watch",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:vitest": "vitest run lib/guardrails.test.ts",
    "test:guardrails": "node --experimental-strip-types test/guardrails.test.ts",
    "test:negotiator": "node --experimental-strip-types test/negotiator.test.ts",
    "test:paypal": "node --experimental-strip-types test/paypal.test.ts",
    "test:e2e": "node --experimental-strip-types test/api_flow.test.ts"
  },
  "dependencies": {
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
