# ==============================================================================
# Mandate: Safe AI Shopping Agent Wallet Configuration
# Copy this file to .env.local: cp .env.local.example .env.local
# ==============================================================================

# 1. Google Gemini API (Free Tier)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. PayPal Developer Sandbox (Orders API v2)
# Get Sandbox keys at: https://developer.paypal.com/dashboard/applications/sandbox
# If left blank, Mandate runs in authentic Simulated Sandbox mode.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# 3. Optional Public App URL (Useful for Vercel/Render deployments)
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
